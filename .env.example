# Supabase (obrigatório em produção)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Motor local (opcional, somente dev local com `next dev`)
# Pula autenticação nas rotas /api/local-clone/* e na página /local-clone.
# Útil para testar o motor sem configurar Supabase. NUNCA defina em produção.
# LOCAL_CLONE_NO_AUTH=1
# NEXT_PUBLIC_LOCAL_CLONE_NO_AUTH=1
